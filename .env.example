# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# The endpoints file (configs/endpoints.toml) names these keys; it never holds a value.
# An endpoint whose url_key is not here yet simply waits, and joins the run as soon as
# the key appears -- that is how a second notebook is added mid-run, and how a Colab
# restart with a new tunnel hostname is picked up without stopping the judge.

# A vLLM served through a Cloudflare tunnel, or on localhost inside Colab.
MEDGEMMA_BASE_URL=http://127.0.0.1:8000/v1
MEDGEMMA_API_KEY=

# A second notebook, added later. Leave blank until it is up.
MEDGEMMA_BASE_URL_2=

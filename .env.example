# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# The endpoints file (configs/endpoints.toml) names these keys. It never holds a value.
#
# A key may arrive late. An endpoint whose url_key is not here yet waits, and joins the
# run as soon as the key appears. That is how a second notebook is added mid-run, and
# how a Colab restart with a new tunnel hostname is picked up without stopping the judge.

# A vLLM served through a Cloudflare tunnel, or on localhost inside Colab.
MEDGEMMA_BASE_URL=http://127.0.0.1:8000/v1
MEDGEMMA_API_KEY=

# A second notebook, added later. Leave blank until it is up.
MEDGEMMA_BASE_URL_2=

# One server with no endpoints file: `llmjudge --base-url ... --model NAME` reads these.
# LLMJUDGE_BASE_URL=
# LLMJUDGE_API_KEY=

# The entries that ship disabled in configs/endpoints.example.toml. Fill one in and set
# enabled = true there to use it.
# AZURE_BASE_URL=https://<resource>.openai.azure.com/openai/deployments/<dep>?api-version=2024-06-01
# AZURE_API_KEY=
# NGROK_URL=
# NGROK_API_KEY=
# NGROK_URL_2=
# NGROK_API_KEY_2=
